<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Target the LTS and roll forward, so the tool runs on whichever .NET 10+ runtime the user has.
         Tools don't roll forward across major versions by default. -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zinc</AssemblyName>
    <RootNamespace>Zinc.Cli</RootNamespace>

    <!-- `dnx zinc ...` runs it one-shot; `dotnet tool install zinc` pins it in a project. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zinc</ToolCommandName>
    <PackageId>zinc</PackageId>
    <!-- Release versions come from the git tag: pushing vX.Y.Z publishes X.Y.Z (see
         .github/workflows/publish.yml). This only names packages from local builds. -->
    <Version>0.0.0-local</Version>
    <Authors>zinc-framework</Authors>
    <Description>Command line tool for the Zinc game framework: create projects and package games for release.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zinc-framework/Zinc.CLI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zinc-framework/Zinc.CLI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.56.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
